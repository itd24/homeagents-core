# =============================================================================
# HomeAgents platform environment. Copy to .env and fill in.
#
# This file lives in the homeagents-core repository and is shared by the other
# repositories, which are expected to sit side by side under one repos root:
#
#   homeagents-core/            this repo: core, finance, programming, web-search
#   homeagents-cli/              management CLI (starts every stage with this .env)
#   dify-deployment/             self-contained, ships its own .env.example
#   librechat-deployment/        reads this .env
#   paperless-qdrant-ingestion/  reads this .env
#   homeagents-mcp-servers/      builds the MCP images used by core and web-search
#
# `.env` is git-ignored. Never commit real values.
# Variables marked REQUIRED must be set before the matching stack starts. The
# rest have working defaults, so you can leave them as they are.
# =============================================================================

# --- LLM provider keys (consumed by core/litellm.yml) ---
# Fill in at least one provider key or chat will not work. Leave the keys you do
# not use empty.
DEEPSEEK_API_KEY=
ZAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# REQUIRED. Any long random string. The proxy uses it for its own auth and
# LibreChat uses it to reach the proxy.
LITELLM_MASTER_KEY=

# REQUIRED. Password for the LiteLLM database and for the Postgres container.
POSTGRES_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379

QDRANT_PORT=6333
QDRANT_MCP_PORT=8765
EMBEDDINGS_MODEL=BAAI/bge-m3
COLLECTION_NAME=memory

TEI_PORT=8081

# --- Web search (web-search/websearch.yml) ---
# SearXNG needs no API key. Tavily tools stay switched off while TAVILY_API_KEY
# is empty.
SEARXNG_URL=http://searxng:8080
SEARXNG_MAX_RESULTS=8
SEARXNG_TIMEOUT=15
# SearXNG session/crypto key. Overrides server.secret_key in
# web-search/config/searxng/settings.yml. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SEARXNG_SECRET=
TAVILY_API_KEY=
TAVILY_TIMEOUT=120

# --- Document ingestion (paperless-qdrant-ingestion/document-ingestion.yml) ---
# REQUIRED for the document-ingestion stage. Replace the example address with
# your own Paperless-ngx instance.
PAPERLESS_URL=https://paperless.example.com/
PAPERLESS_API_TOKEN=
# In-network service URLs - already set in the compose file, override only if
# your service names differ.
# QDRANT_URL=http://qdrant:6333
# TEI_URL=http://embeddings:80
# STATE_FILE=/app/data/ingestion-state.json
# INGESTION_MAP_FILE=/app/config/ingestion-map.yaml

# --- LibreChat (librechat-deployment/librechat.yml) ---
# The four secret values below are REQUIRED and each one must be a long random
# hex string.
LIBRECHAT_PORT=3080
LIBRECHAT_CREDS_KEY=
LIBRECHAT_CREDS_IV=
LIBRECHAT_JWT_SECRET=
LIBRECHAT_JWT_REFRESH_SECRET=

# OAuth client for the Google Workspace MCP servers (Drive, Calendar). Needed
# only when you use those two servers.
GOOGLE_WORKSPACE_MCP_CLIENT_ID=
GOOGLE_WORKSPACE_MCP_CLIENT_SECRET=

# --- Firefly III MCP (finance/firefly-mcp.yml) ---
# REQUIRED for the finance stage. Point this at your own Firefly III instance.
FIREFLY_URL=http://firefly.example.com
# Firefly III personal access token. Firefly III tokens cannot be scoped to
# read-only, so treat this as full access to your finance data.
FIREFLY_TOKEN=

LOG_LEVEL=INFO

# --- OpenHands (programming/openhands.yml) ---
# REQUIRED for the programming stage. Absolute host path mounted as the agent's
# workspace, for example D:\Projects
PROJECTS_PATH=

